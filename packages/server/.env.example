# https://docs.heyform.net/configuration

# App serve
# If you are developing locally, you can use http://[ip]:[port].
NODE_ENV=development
APP_HOMEPAGE_URL=http://localhost:9157
ENABLE_GOOGLE_FONTS=false
# Disabled by default so a directly reachable app cannot trust spoofed forwarding headers.
# Set to the exact Express trust-proxy value for your known reverse-proxy topology.
TRUST_PROXY=false
# Comma-separated list of dashboard origins allowed to make credentialed API requests.
# Defaults to APP_HOMEPAGE_URL when omitted.
CORS_ALLOWED_ORIGINS=http://localhost:9157
# Dangerous: only enable this for isolated local development when a webhook or
# image proxy must reach localhost. Private outbound access fails closed otherwise.
HEYFORM_ALLOW_PRIVATE_OUTBOUND=false

# If you are deploying to a server, please replace it with your domain.
# APP_HOMEPAGE_URL=https://heyform.net

# Auth
# Disable password login and registration in both the UI and API; configure a social login provider first.
DISABLE_LOGIN_WITH_PASSWORD=false
SESSION_MAX_AGE=15d
SESSION_KEY="key1"
FORM_ENCRYPTION_KEY="key2"

# Mongo
MONGO_URI="mongodb://localhost:27017/heyform"
MONGO_USER=
MONGO_PASSWORD=

# Upload
UPLOAD_FILE_TYPES=".jpg,.png,.bmp,.gif,.txt,.md,.doc,.docx,.xls,.xlsx,.csv,.ppt,.pptx,.pdf,.mp4,.wmv,.zip,.rar,.7z"

# SMTP
SMTP_FROM="HeyForm <noreply@example.com>"
SMTP_HOST="example.com"
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Email verify
VERIFY_EMAIL_RESEND_COOLDOWN=60s
VERIFY_EMAIL_RESEND_DAILY_LIMIT=20

# Social login
APPLE_LOGIN_TEAM_ID=
APPLE_LOGIN_WEB_CLIENT_ID=
APPLE_LOGIN_KEY_ID=
APPLE_LOGIN_PRIVATE_KEY_PATH=

# https://docs.heyform.net/login-with-google
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=

# Generic OpenID Connect login
# Register this callback URL with the identity provider:
# ${APP_HOMEPAGE_URL}/connect/oidc/callback
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER=
OIDC_DISPLAY_NAME=SSO
OIDC_DISPLAY_ICON_URL=
# Must match the provider client registration: client_secret_basic or client_secret_post.
OIDC_CLIENT_AUTH_METHOD=client_secret_basic
# Allow a new OIDC identity to create an account when APP_DISABLE_REGISTRATION=true.
OIDC_ALLOW_PROVISIONING=false

# Submission spam filter
AKISMET_KEY=

# Anti bot
# https://www.google.com/recaptcha/about/
GOOGLE_RECAPTCHA_KEY=
GOOGLE_RECAPTCHA_SECRET=

# Bull & redis
BULL_JOB_ATTEMPTS=3
BULL_JOB_BACKOFF_DELAY=3000
BULL_JOB_BACKOFF_TYPE=fixed

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_DB=0
# JSON object passed to ioredis as TLS connection options. Leave empty for plaintext;
# use {} to enable TLS with Node.js defaults, or provide options such as {"servername":"redis.example.com"}.
REDIS_TLS=

# Unsplash
UNSPLASH_CLIENT_ID=

# Stripe
# https://docs.heyform.net/connect-with-stripe
STRIPE_PUBLISHABLE_KEY=pk_
STRIPE_SECRET_KEY=sk_
STRIPE_CONNECT_CLIENT_ID=ca_
STRIPE_WEBHOOK_SECRET_KEY=whsec_

# OpenAI
OPENAI_BASE_URL=
OPENAI_API_KEY=
