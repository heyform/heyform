# https://docs.heyform.net/configuration

# App serve
# If you are developing locally, you can use http://[ip]:[port].
NODE_ENV=development
APP_HOMEPAGE_URL=http://localhost:9157
ENABLE_GOOGLE_FONTS=false
# Disabled by default so a directly reachable app cannot trust spoofed forwarding headers.
# Set to the exact Express trust-proxy value for your known reverse-proxy topology.
TRUST_PROXY=false
# Comma-separated list of dashboard origins allowed to make credentialed API requests.
# Defaults to APP_HOMEPAGE_URL when omitted.
CORS_ALLOWED_ORIGINS=http://localhost:9157
# Dangerous: only enable this for isolated local development when a webhook or
# image proxy must reach localhost. Private outbound access fails closed otherwise.
HEYFORM_ALLOW_PRIVATE_OUTBOUND=false

# If you are deploying to a server, please replace it with your domain.
# APP_HOMEPAGE_URL=https://heyform.net

# Auth
# Disable password login and registration in both the UI and API; configure a social login provider first.
DISABLE_LOGIN_WITH_PASSWORD=false
SESSION_MAX_AGE=15d
SESSION_KEY="key1"
FORM_ENCRYPTION_KEY="key2"

# Encrypts integration credentials: saved API keys and OAuth2 tokens. Separate
# from FORM_ENCRYPTION_KEY, so rotating either never breaks the other. Without
# it, integrations that need credentials are unavailable (the webhook still
# works). Use a long random value, e.g. `openssl rand -base64 32`.
#
# To rotate it:
#   1. Set INTEGRATION_ENCRYPTION_KEY_PREVIOUS to the current value and
#      INTEGRATION_ENCRYPTION_KEY to a new one, then restart. Both keys read;
#      every write (and every token refresh) uses the new one.
#   2. Re-encrypt what's still on the old key:
#        node dist/src/cli/reencrypt-integration-secrets.js   (built server / Docker)
#        pnpm integrations:reencrypt                          (source checkout)
#   3. Remove INTEGRATION_ENCRYPTION_KEY_PREVIOUS and restart.
# Losing the key means every connected account and API key has to be entered
# again.
INTEGRATION_ENCRYPTION_KEY=
INTEGRATION_ENCRYPTION_KEY_PREVIOUS=

# Require password sign-ups to confirm a code sent by email (default true).
# Set to false when no SMTP server is configured, otherwise nobody can finish signing up.
VERIFY_USER_EMAIL=true

# Mongo
MONGO_URI="mongodb://localhost:27017/heyform"
MONGO_USER=
MONGO_PASSWORD=

# Upload
UPLOAD_FILE_TYPES=".jpg,.png,.bmp,.gif,.txt,.md,.doc,.docx,.xls,.xlsx,.csv,.ppt,.pptx,.pdf,.mp4,.wmv,.zip,.rar,.7z"

# SMTP
SMTP_FROM="HeyForm <noreply@example.com>"
SMTP_HOST="example.com"
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Email verify
VERIFY_EMAIL_RESEND_COOLDOWN=60s
VERIFY_EMAIL_RESEND_DAILY_LIMIT=20

# Social login
APPLE_LOGIN_TEAM_ID=
APPLE_LOGIN_WEB_CLIENT_ID=
APPLE_LOGIN_KEY_ID=
APPLE_LOGIN_PRIVATE_KEY_PATH=

# https://docs.heyform.net/login-with-google
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=

# Generic OpenID Connect login
# Register this callback URL with the identity provider:
# ${APP_HOMEPAGE_URL}/connect/oidc/callback
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER=
OIDC_DISPLAY_NAME=SSO
OIDC_DISPLAY_ICON_URL=
# Must match the provider client registration: client_secret_basic or client_secret_post.
OIDC_CLIENT_AUTH_METHOD=client_secret_basic
# Allow a new OIDC identity to create an account when APP_DISABLE_REGISTRATION=true.
OIDC_ALLOW_PROVISIONING=false

# Integrations that connect an account over OAuth2. Like GOOGLE_LOGIN_CLIENT_ID
# for login, each installation registers one OAuth client per provider, once,
# and sets <PROVIDER>_INTEGRATION_CLIENT_ID and <PROVIDER>_INTEGRATION_CLIENT_SECRET
# for it. Form owners then only click "Connect <provider> account".
# Register ${APP_HOMEPAGE_URL}/api/integrations/oauth/callback as the redirect URI.
# Apps using a provider stay hidden until its client ID and secret are set.
# Tokens are encrypted with INTEGRATION_ENCRYPTION_KEY (above).

# Google (Google Sheets): a "Web application" OAuth client in a Google Cloud
# project with the Google Sheets API enabled. Set the OAuth consent screen to
# "In production" (unverified is fine for your own users) or "Internal" for a
# Google Workspace. In "Testing", Google expires refresh tokens after 7 days
# and connections stop working.
GOOGLE_INTEGRATION_CLIENT_ID=
GOOGLE_INTEGRATION_CLIENT_SECRET=

# Submission spam filter
AKISMET_KEY=

# Anti bot
# https://www.google.com/recaptcha/about/
GOOGLE_RECAPTCHA_KEY=
GOOGLE_RECAPTCHA_SECRET=

# Bull & redis
BULL_JOB_ATTEMPTS=3
BULL_JOB_BACKOFF_DELAY=3000
BULL_JOB_BACKOFF_TYPE=fixed

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_DB=0
# JSON object passed to ioredis as TLS connection options. Leave empty for plaintext;
# use {} to enable TLS with Node.js defaults, or provide options such as {"servername":"redis.example.com"}.
REDIS_TLS=

# Unsplash
UNSPLASH_CLIENT_ID=

# Stripe
# https://docs.heyform.net/connect-with-stripe
STRIPE_PUBLISHABLE_KEY=pk_
STRIPE_SECRET_KEY=sk_
STRIPE_CONNECT_CLIENT_ID=ca_
STRIPE_WEBHOOK_SECRET_KEY=whsec_

# OpenAI
OPENAI_BASE_URL=
OPENAI_API_KEY=
